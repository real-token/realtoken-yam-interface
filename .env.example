# Environment
VITE_NODE_ENV=development
VITE_ENV=dev

# Sepolia (Testnet)
VITE_SEPOLIA_WSS_URL=wss://sepolia.example.com
VITE_SEPOLIA_RPC_URL=https://sepolia.example.com

# Gnosis
VITE_GNOSIS_WSS_URL=wss://gnosis.example.com
VITE_GNOSIS_RPC_URL=https://gnosis.example.com

# Ethereum
VITE_ETH_WSS_URL=wss://eth.example.com
VITE_ETH_RPC_URL=https://eth.example.com

# Web3Auth (dashboard.web3auth.io)
# Si absent ou placeholder : modale wagmi (MetaMask, etc.) à la place de la modale AA.
VITE_WEB3_AUTH_API_KEY=your_web3auth_api_key
# Doit correspondre au réseau du projet dans le dashboard Web3Auth (souvent sapphire_mainnet).
# Sans override : sapphire_devnet si VITE_NODE_ENV=development|local|testnet, sinon sapphire_mainnet.
# VITE_WEB3AUTH_NETWORK=sapphire_mainnet

# false = désactive l’onglet RealToken AA même si Web3Auth est configuré
# VITE_ENABLE_AA_WALLET_LOGIN=false

# WalletConnect (cloud.walletconnect.com)
VITE_WC_PROJECTID=your_walletconnect_project_id
VITE_WC_URL=https://yam.realtoken.network

# Etherspot
VITE_ETHERSPOT_KEY=your_etherspot_key

# Show all networks (true/false)
VITE_SHOW_ALL_NETWORKS=false

# API
VITE_API_URL=https://api.realtoken.network/graphql

# Dev local uniquement (jamais nécessaire en prod — domaine autorisé côté API)
# Priorité : login AUTH_USER/AUTH_PASSWORD → repli AUTH_TOKEN
# Mot de passe avec $ : utiliser des guillemets simples, ex. AUTH_PASSWORD='mon$mdp'
AUTH_USER=
AUTH_PASSWORD=
AUTH_TOKEN=

# Ne pas utiliser VITE_API_KEY (exposé dans le bundle navigateur)

# Server-side only (for Vercel Functions)
GNOSIS_RPC_URL=https://gnosis.example.com
ETHEREUM_RPC_URL=https://eth.example.com
SEPOLIA_RPC_URL=https://sepolia.example.com
COMMUNITY_API_KEY=your_community_api_key
